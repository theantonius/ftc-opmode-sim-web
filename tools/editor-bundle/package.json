{
  "name": "ftc-opmode-sim-web-editor-bundle",
  "private": true,
  "description": "Builds web/vendor/codemirror.js (CodeMirror 6, MIT). Run: npm ci && npm run build",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=../../web/vendor/codemirror.js"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "esbuild": "0.28.2"
  }
}
